# Environment Variables Example for PulseWatch

# App Environment
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
# For local Docker: postgresql://pulsewatch:pulsewatch_secret@localhost:5432/pulsewatch?schema=public
DATABASE_URL=postgresql://pulsewatch:pulsewatch_secret@localhost:5432/pulsewatch?schema=public
DIRECT_URL=postgresql://pulsewatch:pulsewatch_secret@localhost:5432/pulsewatch?schema=public

# Redis & BullMQ
REDIS_URL=redis://localhost:6379

# Security & Secrets
# Generate random 32+ char string
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long_pulsewatch
# 32-byte hex key for AES-256-GCM encryption (64 hex characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Worker Execution
# When true, runs BullMQ queue workers embedded in the Express API process
RUN_WORKER_IN_API=true

# AI Provider (Optional for Week 1, required for Week 3)
AI_PROVIDER=gemini
AI_API_KEY=

# Email SMTP (Optional for Week 1, required for Week 3)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM=notifications@pulsewatch.dev
