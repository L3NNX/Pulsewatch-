datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum MonitorStatus {
  PENDING
  UP
  DOWN
  PAUSED
}

enum HttpMethod {
  GET
  HEAD
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

enum SummarySource {
  AI
  TEMPLATE
}

enum ChannelType {
  EMAIL
  DISCORD
  SLACK
  WEBHOOK
}

enum DeliveryEvent {
  INCIDENT_OPENED
  INCIDENT_RESOLVED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  name          String
  createdAt     DateTime       @default(now()) @map("created_at")

  monitors      Monitor[]
  alertChannels AlertChannel[]
  statusPage    StatusPage?

  @@map("users")
}

model Monitor {
  id                    String        @id @default(uuid())
  userId                String        @map("user_id")
  name                  String
  url                   String
  method                HttpMethod    @default(GET)
  intervalSeconds       Int           @default(300) @map("interval_seconds")
  timeoutMs             Int           @default(10000) @map("timeout_ms")
  expectedStatusMin     Int           @default(200) @map("expected_status_min")
  expectedStatusMax     Int           @default(399) @map("expected_status_max")
  isActive              Boolean       @default(true) @map("is_active")
  status                MonitorStatus @default(PENDING)
  consecutiveFailures   Int           @default(0) @map("consecutive_failures")
  consecutiveSuccesses  Int           @default(0) @map("consecutive_successes")
  lastCheckedAt         DateTime?     @map("last_checked_at")
  lastStatusChangeAt    DateTime?     @map("last_status_change_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checks                Check[]
  incidents             Incident[]
  statusPageMonitors    StatusPageMonitor[]

  @@index([userId])
  @@map("monitors")
}

model Check {
  id             BigInt    @id @default(autoincrement())
  monitorId      String    @map("monitor_id")
  checkedAt      DateTime  @default(now()) @map("checked_at")
  isSuccess      Boolean   @map("is_success")
  statusCode     Int?      @map("status_code")
  responseTimeMs Int?      @map("response_time_ms")
  errorType      String?   @map("error_type")
  errorMessage   String?   @map("error_message")

  monitor        Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt(sort: Desc)])
  @@map("checks")
}

model Incident {
  id                String          @id @default(uuid())
  monitorId         String          @map("monitor_id")
  status            IncidentStatus  @default(OPEN)
  startedAt         DateTime        @default(now()) @map("started_at")
  resolvedAt        DateTime?       @map("resolved_at")
  cause             String?
  failedChecksCount Int             @default(0) @map("failed_checks_count")
  aiSummary         String?         @map("ai_summary")
  summarySource     SummarySource?  @map("summary_source")

  monitor           Monitor         @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  deliveries        AlertDelivery[]

  @@index([monitorId])
  @@map("incidents")
}

model AlertChannel {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  type            ChannelType
  name            String
  configEncrypted String          @map("config_encrypted")
  isEnabled       Boolean         @default(true) @map("is_enabled")
  createdAt       DateTime        @default(now()) @map("created_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries      AlertDelivery[]

  @@index([userId])
  @@map("alert_channels")
}

model AlertDelivery {
  id          String         @id @default(uuid())
  incidentId  String         @map("incident_id")
  channelId   String         @map("channel_id")
  event       DeliveryEvent
  status      DeliveryStatus @default(PENDING)
  attempts    Int            @default(0)
  lastError   String?        @map("last_error")
  sentAt      DateTime?      @map("sent_at")

  incident    Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  channel     AlertChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([channelId])
  @@map("alert_deliveries")
}

model StatusPage {
  id          String              @id @default(uuid())
  userId      String              @unique @map("user_id")
  slug        String              @unique
  title       String
  description String?
  isPublic    Boolean             @default(true) @map("is_public")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitors    StatusPageMonitor[]

  @@map("status_pages")
}

model StatusPageMonitor {
  statusPageId String     @map("status_page_id")
  monitorId    String     @map("monitor_id")

  statusPage   StatusPage @relation(fields: [statusPageId], references: [id], onDelete: Cascade)
  monitor      Monitor    @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@id([statusPageId, monitorId])
  @@map("status_page_monitors")
}

